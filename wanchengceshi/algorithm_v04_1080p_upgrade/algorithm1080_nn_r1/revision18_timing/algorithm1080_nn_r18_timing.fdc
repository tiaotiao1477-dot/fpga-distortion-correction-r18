define_attribute {p:cam_sda} {PAP_IO_PULLUP} {TRUE}
define_attribute {p:cam_sda} {PAP_IO_SLEW} {FAST}
define_attribute {p:cam_reset_n} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:cam_reset_n} {PAP_IO_LOC} {V17}
define_attribute {p:cam_reset_n} {PAP_IO_VCCIO} {3.3}
define_attribute {p:cam_reset_n} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:cam_reset_n} {PAP_IO_DRIVE} {4}
define_attribute {p:cam_reset_n} {PAP_IO_NONE} {TRUE}
define_attribute {p:cam_reset_n} {PAP_IO_SLEW} {FAST}
define_attribute {p:cam_pwdn} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:cam_pwdn} {PAP_IO_LOC} {V16}
define_attribute {p:cam_pwdn} {PAP_IO_VCCIO} {3.3}
define_attribute {p:cam_pwdn} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:cam_pwdn} {PAP_IO_DRIVE} {4}
define_attribute {p:cam_pwdn} {PAP_IO_NONE} {TRUE}
define_attribute {p:cam_pwdn} {PAP_IO_SLEW} {FAST}
define_attribute {p:camera_init_done_led} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:camera_init_done_led} {PAP_IO_LOC} {A17}
define_attribute {p:camera_init_done_led} {PAP_IO_VCCIO} {3.3}
define_attribute {p:camera_init_done_led} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:camera_init_done_led} {PAP_IO_DRIVE} {8}
define_attribute {p:camera_init_done_led} {PAP_IO_PULLUP} {TRUE}
define_attribute {p:camera_init_done_led} {PAP_IO_SLEW} {FAST}
# Onboard CP2102 USB-UART.
# J17 onboard USB-UART / CP2102 mapping from the official UART example.
# FPGA_UART_RXD -> FPGA B24; FPGA_UART_TXD -> FPGA C24.
define_attribute {p:uart_rx} {PAP_IO_DIRECTION} {INPUT}
define_attribute {p:uart_rx} {PAP_IO_LOC} {B24}
define_attribute {p:uart_rx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_rx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_rx} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx} {PAP_IO_DIRECTION} {OUTPUT}
define_attribute {p:uart_tx} {PAP_IO_LOC} {C24}
define_attribute {p:uart_tx} {PAP_IO_VCCIO} {3.3}
define_attribute {p:uart_tx} {PAP_IO_STANDARD} {LVCMOS33}
define_attribute {p:uart_tx} {PAP_IO_DRIVE} {8}
define_attribute {p:uart_tx} {PAP_IO_NONE} {TRUE}
define_attribute {p:uart_tx} {PAP_IO_SLEW} {SLOW}
# RAW1080 candidate: 1920x1080, nominal module24MHz XVCLK,
# 0x3035=0x20 and0x3036=0x54 predict84MHz PCLK; actual mode needs readback.
# T=1/84MHz=11.904762ns. Recheck against measured PCLK on the board.
create_clock -name {cam_pclk} [get_ports {cam_pclk}] -period {11.904762} -waveform {0.000 5.952381}
# The DVP inputs change on physical PCLK falling edges. This phase-shifted
# virtual reference represents those edges for FDC's supported input-delay
# syntax; its rising edge at 5.952381 ns is the physical cam_pclk falling edge.
create_clock -name {cam_pclk_fall_ref} -period {11.904762} -waveform {5.952381 11.904762}
# Register 0x4740[5]=1 means DVP data changes on falling PCLK; FPGA samples
# on rising PCLK. The sensor/module's exact board-level tCO is not specified
# in its public DVP timing table, so retain the existing 0.2..5.5 ns envelope
# as a conservative working assumption pending module-specific measurement.
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_data[0]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_data[0]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_data[1]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_data[1]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_data[2]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_data[2]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_data[3]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_data[3]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_data[4]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_data[4]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_data[5]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_data[5]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_data[6]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_data[6]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_data[7]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_data[7]}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_href}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_href}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -min {0.200} [get_ports {cam_vsync}]
set_input_delay -clock [get_clocks {cam_pclk_fall_ref}] -max {5.500} [get_ports {cam_vsync}]
# SCCB divider: 27 MHz / (2*675) = 20 kHz. Include this fabric clock in STA.
create_generated_clock -name sccb_clk -source [get_ports {sys_clk}] -divide_by 1350 [get_pins {u_camera_config/clock_20k}]
# Intentional asynchronous assertion into reset synchronizers only.
# The three stages time reset release in the destination domain. Do not cut D paths.
# reset_sync samples status signals synchronously; no recovery/removal paths.
# cfg_clk (10 MHz) and pix_clk (74.25MHz) are independent PLL outputs.
# Name the generated clocks explicitly before declaring the CDC boundary.
create_generated_clock -name {cfg_clk} -source [get_ports {sys_clk}] [get_pins {cfg_pll_inst/u_gpll/CLKOUT0}] -master_clock [get_clocks {sys_clk}] -multiply_by {10} -divide_by {27}
create_generated_clock -name {pix_clk} -source [get_ports {sys_clk}] [get_pins {pll_gen_clk/u_gpll/CLKOUT0}] -master_clock [get_clocks {sys_clk}] -multiply_by {11} -divide_by {4}



# New RAW/display Gray first stages must remain visible in routed STA.
set_max_delay -datapath_only 7.000 -from [get_clocks {cam_pclk}] -to [get_cells -hierarchical {g_storage_bypass_framebuffer.raw_camera/raw_fifo/*write_sync1*}]
set_max_skew 7.000 -from [get_clocks {cam_pclk}] -to [get_cells -hierarchical {g_storage_bypass_framebuffer.raw_camera/raw_fifo/*write_sync1*}]
set_max_delay -datapath_only 7.000 -from [get_clocks {ddrphy_sysclk}] -to [get_cells -hierarchical {g_storage_bypass_framebuffer.raw_camera/raw_fifo/*consumed_sync1*}]
set_max_skew 7.000 -from [get_clocks {ddrphy_sysclk}] -to [get_cells -hierarchical {g_storage_bypass_framebuffer.raw_camera/raw_fifo/*consumed_sync1*}]
set_max_delay -datapath_only 7.000 -from [get_clocks {ddrphy_sysclk}] -to [get_cells -hierarchical {g_storage_bypass_framebuffer.u_storage_pipeline_core/u_display_pixel_cdc/u_result_pixel_fifo/*write_sync1*}]
set_max_skew 7.000 -from [get_clocks {ddrphy_sysclk}] -to [get_cells -hierarchical {g_storage_bypass_framebuffer.u_storage_pipeline_core/u_display_pixel_cdc/u_result_pixel_fifo/*write_sync1*}]
set_max_delay -datapath_only 7.000 -from [get_clocks {pix_clk}] -to [get_cells -hierarchical {g_storage_bypass_framebuffer.u_storage_pipeline_core/u_display_pixel_cdc/u_result_pixel_fifo/*consumed_sync1*}]
set_max_skew 7.000 -from [get_clocks {pix_clk}] -to [get_cells -hierarchical {g_storage_bypass_framebuffer.u_storage_pipeline_core/u_display_pixel_cdc/u_result_pixel_fifo/*consumed_sync1*}]
# Remaining scalar/bundled CDC paths require explicit audit after native compile.


# R6R2: native RTL vector D[index] and mapped bit/opit/D, first stage ONLY.
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.dvp_pclk_sync1(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_cam_pclk_input_probe/pclk_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_camera_dvp_led\.u_camera_diag_status_sync/status_meta\[[0-9]+:[0-9]+\]/D\[0\]|g_camera_dvp_led\.u_camera_diag_status_sync/status_meta\[0\](/[^/]+)?/D)$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_camera_dvp_led\.u_camera_diag_status_sync/status_meta\[[0-9]+:[0-9]+\]/D\[1\]|g_camera_dvp_led\.u_camera_diag_status_sync/status_meta\[1\](/[^/]+)?/D)$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_camera_dvp_led\.u_camera_diag_status_sync/status_meta\[[0-9]+:[0-9]+\]/D\[2\]|g_camera_dvp_led\.u_camera_diag_status_sync/status_meta\[2\](/[^/]+)?/D)$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_camera_dvp_led\.u_camera_diag_status_sync/status_meta\[[0-9]+:[0-9]+\]/D\[4\]|g_camera_dvp_led\.u_camera_diag_status_sync/status_meta\[4\](/[^/]+)?/D)$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_camera_dvp_diag/req_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_diag_ddr_snapshot/request_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_diag_display_roi/request_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_diag_pix_snapshot/request_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_diag_snapshot_status/ack_cam_color_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_diag_snapshot_status/ack_cam_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_diag_snapshot_status/ack_ddr_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_diag_snapshot_status/ack_disp_color_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_diag_snapshot_status/ack_pix_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_vsync_to_ddr/dst_event_meta(/[^/]+)?/D(\[0\])?$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_sys_diag_cdc/status_meta\[[0-9]+:[0-9]+\]/D\[0\]|u_sys_diag_cdc/status_meta\[0\](/[^/]+)?/D)$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_sys_diag_cdc/status_meta\[[0-9]+:[0-9]+\]/D\[1\]|u_sys_diag_cdc/status_meta\[1\](/[^/]+)?/D)$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_sys_diag_cdc/status_meta\[[0-9]+:[0-9]+\]/D\[2\]|u_sys_diag_cdc/status_meta\[2\](/[^/]+)?/D)$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_sys_diag_cdc/status_meta\[[0-9]+:[0-9]+\]/D\[3\]|u_sys_diag_cdc/status_meta\[3\](/[^/]+)?/D)$}]

# Dedicated reset assertion pins only; no functional reset, local stage D or CE cut.
set_false_path -to [get_pins -hierarchical -regexp {^(g_framebuffer_reset\.u_video_reset/sync_ff\[[0-9]+:[0-9]+\]/C|g_framebuffer_reset\.u_video_reset/sync_ff\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_framebuffer_reset\.u_video_reset/sync_ff\[[0-9]+:[0-9]+\]/C|g_framebuffer_reset\.u_video_reset/sync_ff\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_framebuffer_reset\.u_video_reset/sync_ff\[[0-9]+:[0-9]+\]/C|g_framebuffer_reset\.u_video_reset/sync_ff\[2\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.raw_camera/camera_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.raw_camera/camera_reset_sync\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.raw_camera/camera_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.raw_camera/camera_reset_sync\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.raw_camera/camera_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.raw_camera/camera_reset_sync\[2\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.raw_camera/core_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.raw_camera/core_reset_sync\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.raw_camera/core_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.raw_camera/core_reset_sync\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.raw_camera/core_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.raw_camera/core_reset_sync\[2\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_ddr_reset/sync_ff\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_ddr_reset/sync_ff\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_ddr_reset/sync_ff\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_ddr_reset/sync_ff\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_ddr_reset/sync_ff\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_ddr_reset/sync_ff\[2\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/dst_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/dst_reset_sync\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/dst_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/dst_reset_sync\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/dst_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/dst_reset_sync\[2\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/src_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/src_reset_sync\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/src_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/src_reset_sync\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/src_reset_sync\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_display_pixel_cdc/src_reset_sync\[2\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_vsync_to_ddr/dst_reset_release\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_vsync_to_ddr/dst_reset_release\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_vsync_to_ddr/dst_reset_release\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_vsync_to_ddr/dst_reset_release\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_vsync_to_ddr/src_reset_release\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_vsync_to_ddr/src_reset_release\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_vsync_to_ddr/src_reset_release\[[0-9]+:[0-9]+\]/C|g_storage_bypass_framebuffer\.u_storage_pipeline_core/u_vsync_to_ddr/src_reset_release\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_capture_reset/sync_ff\[[0-9]+:[0-9]+\]/C|u_capture_reset/sync_ff\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_capture_reset/sync_ff\[[0-9]+:[0-9]+\]/C|u_capture_reset/sync_ff\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_capture_reset/sync_ff\[[0-9]+:[0-9]+\]/C|u_capture_reset/sync_ff\[2\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_sys_diag_cdc/reset_sync\[[0-9]+:[0-9]+\]/C|u_sys_diag_cdc/reset_sync\[0\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_sys_diag_cdc/reset_sync\[[0-9]+:[0-9]+\]/C|u_sys_diag_cdc/reset_sync\[1\](/[^/]+)?/(C|RS))$}]
set_false_path -to [get_pins -hierarchical -regexp {^(u_sys_diag_cdc/reset_sync\[[0-9]+:[0-9]+\]/C|u_sys_diag_cdc/reset_sync\[2\](/[^/]+)?/(C|RS))$}]

# Held source and destination only: preserve16/37ns max-delay; remove phase hold for same pair.
set_max_delay -datapath_only 37.000 -from [get_cells -hierarchical -regexp {^g_camera_dvp_led\.(u_diag_(ddr|pix)_snapshot/snapshot_bus\[[0-9:]+\]|u_camera_dvp_diag/snap_[a-zA-Z0-9_]+\[[0-9:]+\]|u_diag_(camera|display)_roi/snapshot_bus\[[0-9:]+\])(/[^/]+)?$}] -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_camera_diag_uart/payload_reg\[[0-9:]+\](/[^/]+)?/D(\[[0-9]+\])?$}]
set_false_path -hold -from [get_cells -hierarchical -regexp {^g_camera_dvp_led\.(u_diag_(ddr|pix)_snapshot/snapshot_bus\[[0-9:]+\]|u_camera_dvp_diag/snap_[a-zA-Z0-9_]+\[[0-9:]+\]|u_diag_(camera|display)_roi/snapshot_bus\[[0-9:]+\])(/[^/]+)?$}] -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_camera_diag_uart/payload_reg\[[0-9:]+\](/[^/]+)?/D(\[[0-9]+\])?$}]

# R7 actual R6R2-preserved ROI request FIRST D; local request_sync remains timed.
set_false_path -to [get_pins -hierarchical -regexp {^g_camera_dvp_led\.u_diag_camera_roi/request_meta(/[^/]+)?/D(\[0\])?$}]

# Raw assertion only into independent reference-clock reset synchronizer.
set_false_path -to [get_pins -hierarchical -regexp {^u_ddr_ref_reset/sync_ff\[2:0\]/C$|^u_ddr_ref_reset/sync_ff\[[012]\](/[^/]+)?/(C|RS)$}]
# Reference release -> vendor FUNCTIONAL reset pins is NOT excepted.

# Restored exact v0.4 configuration CDC scopes only.
set_false_path -to [get_pins -hierarchical -regexp {^(u_v04_uart_control/cdc/ack_sync\[[0-9]+:[0-9]+\]/D\[0\]|u_v04_uart_control/cdc/ack_sync\[0\](/[^/]+)?/D)$}]
